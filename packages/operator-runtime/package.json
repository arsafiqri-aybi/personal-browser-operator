{
  "name": "@pbo/operator-runtime",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx src/server.ts",
    "start:http": "tsx src/http.ts",
    "start:console": "tsx src/console.ts",
    "start:mobile": "tsx src/mobile-server.ts",
    "start:mobile:http": "tsx src/mobile-http.ts",
    "start:prod:http": "node dist/http.js",
    "start:prod:console": "node dist/console.js",
    "start:prod:mobile:http": "node dist/mobile-http.js",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test test/unit/*.test.ts",
    "test:contract": "tsx --test test/contract/*.test.ts",
    "test:browser": "tsx --test test/browser/*.test.ts",
    "test:remote-container": "tsx test/deployment/remote-mcp-smoke.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.0",
    "jose": "6.2.12",
    "playwright": "1.63.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.0",
    "@types/node": "24.10.0",
    "tsx": "4.20.6",
    "typescript": "6.0.2"
  }
}
