# Persistent runtime root. Never commit the resulting directory.
PBO_DATA_DIR=./runtime-data

# Browser mode. Set false for visible browser / human takeover on a desktop host.
PBO_HEADLESS=true

# Highest action risk class automatically permitted.
PBO_AUTO_RISK=R2

# Browser network policy.
PBO_ALLOW_PRIVATE_NETWORKS=false

# Remote MCP transport.
PBO_HOST=127.0.0.1
PBO_PORT=8787

# Required when binding PBO_HOST beyond loopback.
PBO_MCP_TOKEN=replace_with_long_random_secret

# Host header allowlist. Add the public MCP hostname when running behind a reverse proxy/tunnel.
PBO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
