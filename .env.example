# Persistent runtime root. Never commit the resulting directory.
PBO_DATA_DIR=./runtime-data

# Browser mode. Set false for visible browser / human takeover on a desktop host.
PBO_HEADLESS=true

# Highest action risk class automatically permitted.
PBO_AUTO_RISK=R2

# Browser network policy.
PBO_ALLOW_PRIVATE_NETWORKS=false

# Remote MCP transport.
PBO_HOST=127.0.0.1
PBO_PORT=8787

# Mobile MCP endpoint. It can run next to the browser MCP or independently.
PBO_MOBILE_HOST=127.0.0.1
PBO_MOBILE_PORT=8790
PBO_MOBILE_MCP_TOKEN=replace_with_long_random_secret

# Android device relay. CONTROL_TOKEN is kept only by the MCP/runtime.
PBO_MOBILE_RELAY_URL=https://personal-mobile-relay.example.workers.dev
PBO_MOBILE_CONTROL_TOKEN=replace_with_relay_control_secret

# Authentication mode.
# static-bearer is the verified bootstrap/CI mode.
PBO_AUTH_MODE=static-bearer
PBO_MCP_TOKEN=replace_with_long_random_secret

# Production OAuth resource-server mode:
# PBO_AUTH_MODE=oauth-jwt
# PBO_PUBLIC_BASE_URL=https://browser.example.com
# PBO_OAUTH_ISSUER=https://identity.example.com
# PBO_OAUTH_JWKS_URI=https://identity.example.com/.well-known/jwks.json
# PBO_OAUTH_AUDIENCE=https://browser.example.com/mcp
# PBO_OAUTH_SCOPE=pbo:mcp

# Host header allowlist for direct MCP runtime access.
PBO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Live takeover/console secrets for the container runtime.
PBO_CONSOLE_TOKEN=replace_with_different_long_random_secret
PBO_VNC_PASSWORD=replace_with_strong_vnc_password
