# Browser profile root. Must NOT be committed if it contains real profile data.
PBO_DATA_DIR=./runtime-data

# true by default. Set false for a visible headed browser during development.
PBO_HEADLESS=true

# Highest action risk class automatically permitted.
PBO_AUTO_RISK=R2

# Keep false unless private-network navigation is explicitly required.
PBO_ALLOW_PRIVATE_NETWORKS=false
