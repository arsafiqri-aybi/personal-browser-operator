# Personal Browser Operator — Railway production variables
#
# Copy variable NAMES into Railway Variables. Do not commit real secrets.
# Railway injects PORT automatically.

PBO_AUTH_MODE=oauth-jwt
PBO_PUBLIC_BASE_URL=https://REPLACE_WITH_RAILWAY_DOMAIN
PBO_OAUTH_ISSUER=https://REPLACE_WITH_OAUTH_ISSUER
PBO_OAUTH_JWKS_URI=https://REPLACE_WITH_OAUTH_ISSUER/.well-known/jwks.json
PBO_OAUTH_AUDIENCE=https://REPLACE_WITH_RAILWAY_DOMAIN/mcp
PBO_OAUTH_SCOPE=pbo:mcp

# Separate control-plane secrets. Generate independently.
PBO_CONSOLE_TOKEN=REPLACE_WITH_LONG_RANDOM_SECRET
PBO_VNC_PASSWORD=REPLACE_WITH_STRONG_SECRET

PBO_AUTO_RISK=R2
PBO_ALLOW_PRIVATE_NETWORKS=false

# Railway volumes are mounted as root. PBO intentionally bootstraps as root,
# fixes /data ownership, then runs Node/Chromium/X11/nginx as pwuser.
RAILWAY_RUN_UID=0
