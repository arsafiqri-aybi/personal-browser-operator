# WorkOS AuthKit candidate profile — values only after creating the environment.
# Do not use this profile until the dynamic-client custom-scope gate is proven.
PBO_AUTH_MODE=oauth-jwt
PBO_PUBLIC_BASE_URL=https://REPLACE_WITH_PBO_DOMAIN
PBO_OAUTH_ISSUER=https://REPLACE_WITH_AUTHKIT_DOMAIN
PBO_OAUTH_JWKS_URI=https://REPLACE_WITH_AUTHKIT_DOMAIN/oauth2/jwks
PBO_OAUTH_AUDIENCE=https://REPLACE_WITH_PBO_DOMAIN/mcp
PBO_OAUTH_SCOPE=pbo:mcp
