# Auth0 candidate profile — values only after creating the tenant/API.
PBO_AUTH_MODE=oauth-jwt
PBO_PUBLIC_BASE_URL=https://REPLACE_WITH_PBO_DOMAIN
PBO_OAUTH_ISSUER=https://REPLACE_WITH_AUTH0_DOMAIN/
PBO_OAUTH_JWKS_URI=https://REPLACE_WITH_AUTH0_DOMAIN/.well-known/jwks.json
PBO_OAUTH_AUDIENCE=https://REPLACE_WITH_PBO_DOMAIN/mcp
PBO_OAUTH_SCOPE=pbo:mcp
